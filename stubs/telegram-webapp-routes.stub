<?php

use App\Http\Controllers\TelegramWebAppController;
use Illuminate\Support\Facades\Route;

// Web page that renders the Mini App
Route::get('/telegram-webapp', [TelegramWebAppController::class, 'index']);

// API endpoints protected by the telegram-webapp validation middleware
Route::middleware('telegram-webapp')->group(function () {
    Route::post('/api/telegram-webapp', [TelegramWebAppController::class, 'user']);
});
